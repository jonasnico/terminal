---
interface Props {
  href: string;
  sourceHref?: string;
  title: string;
  description: string;
  image?: string;
  tags?: string[];
}

const { href, sourceHref, title, description, image, tags } = Astro.props;
const Tag = sourceHref ? "article" : "a";
---

<Tag href={sourceHref ? undefined : href} class="card-link">
  <div class="card">
    {image && <img src={image} alt={title} class="card-image" />}
    <div class="card-content">
      <h2 class="card-title">{title}</h2>
      <p class="card-description">{description}</p>
      {
        tags && tags.length > 0 && (
          <div class="card-tags">
            {tags.map((tag) => (
              <span class="card-tag">{tag}</span>
            ))}
          </div>
        )
      }
      {
        sourceHref && (
          <div class="card-actions">
            {href !== sourceHref && (
              <a href={href} aria-label={`Live demo of ${title}`}>Live demo</a>
            )}
            <a href={sourceHref} aria-label={`View ${title} on GitHub`}>GitHub</a>
          </div>
        )
      }
    </div>
  </div>
</Tag>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    min-width: 0;
    border: 1px solid var(--theme-border);
    background-color: var(--theme-surface);
  }

  .card-link:hover,
  .card-link:focus-within {
    border-color: var(--theme-text);
  }

  a.card-link:hover,
  a.card-link:focus {
    background: var(--theme-surface);
    color: inherit;
  }

  .card {
    display: flex;
    flex-direction: column;
    line-height: 1.5;
    height: 100%;
  }

  .card-image {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-bottom: 1px solid var(--theme-border);
  }

  .card-content {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-title {
    font-size: 1.25rem;
    color: var(--theme-accent-2);
    margin: 0;
    font-family: var(--font-family-mono);
  }

  .card-description {
    font-size: 1rem;
    color: var(--theme-text-muted);
    flex: 1;
  }

  .card-tags {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .card-tag {
    background-color: var(--theme-border-subdued);
    color: var(--theme-text);
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
    font-family: var(--font-family-mono);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .card-actions a {
    padding-block: 0.25rem;
    text-underline-offset: 0.2em;
  }
</style>
